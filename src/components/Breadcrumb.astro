---
interface Item { label: string; href?: string }
const { items } = Astro.props as {items: Item[]};
const schema = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:items.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.label,...(item.href?{item:new URL(item.href,Astro.site).href}:{})})) };
---
<nav class="breadcrumb" aria-label="Fil d’Ariane">{items.map((item,i) => <>{i>0 && <span aria-hidden="true">/</span>}{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}</>)}</nav><script type="application/ld+json" set:html={JSON.stringify(schema)} />
