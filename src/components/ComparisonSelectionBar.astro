---
import { dynamicComparatorContract } from '@/data/dynamic-comparator';
import '@/styles/dynamic-comparator.css';
---
<aside class="comparison-selection-bar" data-comparison-selection-bar hidden aria-live="polite"><div><strong>Votre comparaison</strong><div data-selection-chips></div></div><p><span data-selection-count>0</span>/3 logiciels</p><a class="button primary" data-selection-link href="/fr/comparatifs/">Comparer</a><button type="button" class="comparison-selection-reset" data-selection-reset>Effacer</button></aside>
<script is:inline type="application/json" id="comparison-selection-software" set:html={JSON.stringify(dynamicComparatorContract.software)} />
<script>
  // @ts-nocheck
  const bar=document.querySelector('[data-comparison-selection-bar]');const registry=JSON.parse(document.querySelector('#comparison-selection-software')?.textContent||'[]');
  if(bar){let selection=[];const buttons=[...document.querySelectorAll('[data-compare-toggle]')];const bySlug=Object.fromEntries(registry.map((item)=>[item.slug,item]));const render=()=>{bar.hidden=!selection.length;bar.querySelector('[data-selection-count]').textContent=String(selection.length);const chips=bar.querySelector('[data-selection-chips]');chips.replaceChildren();selection.forEach((slug)=>{const chip=document.createElement('span');chip.textContent=bySlug[slug]?.name||slug;chips.append(chip)});const link=bar.querySelector('[data-selection-link]');link.href=selection.length>=2?`/fr/comparatifs/?software=${selection.join(',')}`:'/fr/comparatifs/';link.setAttribute('aria-disabled',String(selection.length<2));buttons.forEach((button)=>{const active=selection.includes(button.dataset.software);button.setAttribute('aria-pressed',String(active));button.textContent=active?'Retirer de la comparaison':'Comparer'})};buttons.forEach((button)=>button.addEventListener('click',()=>{const slug=button.dataset.software;if(selection.includes(slug))selection=selection.filter((item)=>item!==slug);else if(selection.length<3){const current=bySlug[selection[0]],next=bySlug[slug];if(current&&next&&current.category!==next.category)selection=[];selection.push(slug)}render();window.dispatchEvent(new CustomEvent('datagraphe:comparison_select',{detail:{software:slug,count:selection.length}}))}));bar.querySelector('[data-selection-reset]').addEventListener('click',()=>{selection=[];render()});render()}
</script>
