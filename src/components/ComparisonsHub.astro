---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import FollowButton from '@/components/FollowButton.astro';
import { dynamicComparatorContract } from '@/data/dynamic-comparator';
import '@/styles/dynamic-comparator.css';

const routePath = 'comparatifs';
const title = 'Comparateur de logiciels testés — Datagraphe';
const description = 'Comparez deux ou trois logiciels à partir de scénarios certifiés, de résultats observés et de limites documentées.';
const software = dynamicComparatorContract.software;
const filterFamilies = [{key:'all',label:'Tout'},{key:'time',label:'Temps'},{key:'team',label:'Équipe'},{key:'projects',label:'Projets'},{key:'reports',label:'Rapports'},{key:'exports',label:'Exports'},{key:'planning',label:'Planning'},{key:'others',label:'Autres'}];
---

<BaseLayout locale="fr" routePath={routePath} title={title} description={description}>
  <header class="dynamic-comparator-hero"><div class="shell">
    <Breadcrumb items={[{label:'Accueil',href:'/fr/'},{label:'Comparatifs'}]} ariaLabel="Accueil — Comparatifs"/>
    <span class="eyebrow">Comparateur Datagraphe</span><h1>Quels logiciels voulez-vous comparer&nbsp;?</h1>
    <p>Choisissez deux ou trois logiciels d’une même catégorie. Seules les différences réellement observées et certifiées sont affichées.</p>
  </div></header>

  <main class="dynamic-comparator" data-dynamic-comparator><div class="shell">
    <section class="comparator-builder" aria-labelledby="comparison-builder-title">
      <div class="comparator-builder-head"><div><span class="eyebrow">Votre sélection</span><h2 id="comparison-builder-title">Comparer des logiciels testés</h2></div><p>2 logiciels minimum · 3 maximum</p></div>
      <form data-comparator-form>
        <label>Logiciel 1<select data-comparator-select required><option value="">Choisir un logiciel</option>{software.map((item)=><option value={item.slug}>{item.name}</option>)}</select></label>
        <span class="comparator-versus" aria-hidden="true">vs</span>
        <label>Logiciel 2<select data-comparator-select required><option value="">Choisir un logiciel</option>{software.map((item)=><option value={item.slug}>{item.name}</option>)}</select></label>
        <span class="comparator-versus comparator-third-control" aria-hidden="true" hidden>vs</span>
        <label class="comparator-third-control" hidden>Logiciel 3<select data-comparator-select><option value="">Choisir un logiciel</option>{software.map((item)=><option value={item.slug}>{item.name}</option>)}</select></label>
        <button class="button secondary comparator-add-third" type="button" data-add-third>+ Ajouter un 3e logiciel</button>
        <button class="button primary" type="submit">Comparer</button>
      </form>
      <p class="comparator-form-error" data-comparator-error role="alert" hidden></p>
    </section>

    <section class="comparator-empty" data-comparator-empty aria-live="polite">
      <div class="comparator-empty-mark" aria-hidden="true"><span></span><span></span><span></span></div>
      <h2>Sélectionnez deux logiciels</h2><p>Le comparateur rapprochera uniquement les scénarios dont la comparabilité a été certifiée par Datagraphe.</p>
    </section>

    <section class="comparator-results" data-comparator-results hidden aria-live="polite">
      <div class="comparator-result-head"><div><span class="eyebrow">Comparaison dynamique</span><h2 data-comparison-title></h2><p data-comparison-summary></p></div><div class="comparator-dates" data-comparison-dates></div></div>
      <p class="comparator-freshness" data-freshness-warning hidden>Les dates d’observation sont éloignées&nbsp;: interprétez les écarts avec prudence.</p>

      <div class="comparator-software-cards">
        {software.map((item) => <article data-comparator-software-card={item.slug} hidden>
          <span class="comparison-kicker">{item.name}</span><h3>{item.coverage.toFixed(1).replace('.',',')}&nbsp;% de couverture</h3>
          <p>Test observé le <time datetime={item.observed_at}>{item.observed_at}</time>.</p>
          <div class="actions"><a class="button secondary" href={item.test_path}>Lire le test</a><FollowButton type="SOFTWARE" targetKey={item.slug} label={`Suivre ${item.name}`} description={`Test ${item.name}`}/></div>
        </article>)}
      </div>

      <div class="comparator-certified" data-certified-section>
        <div class="comparison-section-head"><div><span class="eyebrow">Dimensions certifiées</span><h2>Ce que les tests permettent de comparer</h2></div><p>Le résultat fonctionnel et le niveau de preuve sont affichés séparément.</p></div>
        <div class="comparator-filters" data-comparator-filters aria-label="Filtrer les dimensions">
          {filterFamilies.map((family,index)=><button type="button" data-family={family.key} aria-pressed={index===0}>{family.label}</button>)}
        </div>
        <div class="comparator-dimension-list" data-dimension-list></div>
      </div>

      <section class="comparator-insufficient" data-insufficient-section hidden>
        <span class="eyebrow">Données insuffisantes</span><h2>Pourquoi certaines lignes sont absentes&nbsp;?</h2>
        <p>Une fonction présente dans plusieurs logiciels ne devient pas automatiquement comparable. Datagraphe exige une certification pair-à-pair avant toute conclusion.</p><div data-insufficient-list></div>
      </section>

      <section class="comparator-buyers" data-buyer-section hidden><span class="eyebrow">Selon votre contexte</span><h2>Ce que la comparaison peut déjà éclairer</h2><div data-buyer-list></div></section>
      <div class="comparator-editorial" data-editorial-link hidden><p>Un dossier éditorial indépendant approfondit cette paire, sans dépendre de l’état du comparateur.</p><a class="button primary" data-editorial-anchor>Lire le comparatif complet</a></div>
    </section>
  </div></main>

  <script is:inline type="application/json" id="dynamic-comparator-contract" set:html={JSON.stringify(dynamicComparatorContract)} />
  <script>
    // @ts-nocheck
    import { buildComparisonSelection } from '@/lib/comparison-selection.mjs';
    const root = document.querySelector('[data-dynamic-comparator]');
    const contract = JSON.parse(document.querySelector('#dynamic-comparator-contract')?.textContent || '{}');
    if (root && contract.software) {
      const form = root.querySelector('[data-comparator-form]');
      const selects = [...root.querySelectorAll('[data-comparator-select]')];
      const error = root.querySelector('[data-comparator-error]');
      const empty = root.querySelector('[data-comparator-empty]');
      const results = root.querySelector('[data-comparator-results]');
      const thirdControls = root.querySelectorAll('.comparator-third-control');
      const addThird = root.querySelector('[data-add-third]');
      const names = Object.fromEntries(contract.software.map((item) => [item.slug, item.name]));
      let currentDimensions = [];
      const node = (tag, className, text) => { const element=document.createElement(tag); if(className)element.className=className; if(text!==undefined)element.textContent=text; return element; };
      const showThird = (show=true) => { thirdControls.forEach((item)=>item.hidden=!show); addThird.hidden=show; if(!show)selects[2].value=''; };
      addThird.addEventListener('click',()=>showThird(true));

      function renderDimensions(family='all') {
        const list=root.querySelector('[data-dimension-list]'); list.replaceChildren();
        currentDimensions.filter((item)=>family==='all'||item.family===family).forEach((item)=>{
          const card=node('article','comparator-dimension-card'); card.dataset.family=item.family;
          const top=node('div','comparator-dimension-top'); top.append(node('span','comparison-kicker',item.localized.fr.scenario_label),node('span',`evidence-badge evidence-${item.evidence_level.toLowerCase()}`,item.evidence_level==='VERIFIED'?'Preuve vérifiée':'Preuve avec réserve')); card.append(top,node('h3','',item.localized.fr.wording));
          const resultGrid=node('div','comparator-result-grid');
          Object.entries(item.results).forEach(([slug,value])=>{const result=node('div','');result.append(node('strong','',names[slug]||slug),node('span',`public-result result-${String(value).toLowerCase().replaceAll('_','-')}`,String(value).replaceAll('_',' ')));resultGrid.append(result)});
          card.append(resultGrid,node('p','comparator-qualifier',item.localized.fr.qualifier)); list.append(card);
        });
        if(!list.children.length)list.append(node('p','comparator-no-dimension','Aucune dimension certifiée ne correspond à ce filtre.'));
      }

      function render(raw, updateInputs=true) {
        const state=buildComparisonSelection(raw,contract);const slugs=state.slugs||[];
        error.hidden=state.valid;error.textContent=state.errors?.length?'Sélection invalide. Choisissez deux ou trois logiciels publiés de la même catégorie, sans doublon.':'';
        if(updateInputs){selects.forEach((select,index)=>select.value=slugs[index]||'');showThird(slugs.length===3)}
        empty.hidden=state.active;results.hidden=!state.active;if(!state.active)return;
        root.querySelector('[data-comparison-title]').textContent=state.selected.map((item)=>item.name).join(' vs ');
        root.querySelector('[data-comparison-summary]').textContent=state.dimensions.length?`${state.dimensions.length} dimensions certifiées sont comparables pour cette sélection.`:'Aucune dimension ne dispose encore de la certification nécessaire pour cette sélection.';
        const dates=root.querySelector('[data-comparison-dates]');dates.replaceChildren();state.selected.forEach((item)=>{const line=node('p','');line.append(node('strong','',item.name),document.createTextNode(` · observé le ${item.observed_at}`));dates.append(line)});
        root.querySelector('[data-freshness-warning]').hidden=!state.freshnessWarning;
        root.querySelectorAll('[data-comparator-software-card]').forEach((card)=>card.hidden=!slugs.includes(card.dataset.comparatorSoftwareCard));
        currentDimensions=state.dimensions;renderDimensions();root.querySelector('[data-certified-section]').hidden=!state.dimensions.length;
        const insufficient=root.querySelector('[data-insufficient-section]'),insufficientList=root.querySelector('[data-insufficient-list]');insufficientList.replaceChildren();
        state.insufficient.forEach((item)=>{const card=node('article','');card.append(node('h3','',item.software.map((slug)=>names[slug]).join(' vs ')),node('p','',item.reason),node('small','',`${item.candidate_count} dimensions communes repérées, sans conclusion publiée.`));insufficientList.append(card)});insufficient.hidden=!state.insufficient.length;
        const buyer=root.querySelector('[data-buyer-section]'),buyerList=root.querySelector('[data-buyer-list]');buyerList.replaceChildren();
        (state.buyerContexts||[]).filter((item)=>item.status!=='INSUFFICIENT_DATA').forEach((item)=>{const card=node('article','');card.append(node('span','comparison-context-status',item.status.replaceAll('_',' ')),node('h3','',item.localized.fr.label),node('p','',item.localized.fr.reason));buyerList.append(card)});buyer.hidden=!buyerList.children.length;
        const editorial=root.querySelector('[data-editorial-link]');editorial.hidden=!state.editorialPath;if(state.editorialPath)root.querySelector('[data-editorial-anchor]').href=state.editorialPath;
        window.dispatchEvent(new CustomEvent('datagraphe:comparison_view',{detail:{software:slugs,count:slugs.length}}));
      }
      root.querySelectorAll('[data-family]').forEach((button)=>button.addEventListener('click',()=>{root.querySelectorAll('[data-family]').forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));renderDimensions(button.dataset.family);window.dispatchEvent(new CustomEvent('datagraphe:comparison_filter',{detail:{family:button.dataset.family}}))}));
      form.addEventListener('submit',(event)=>{event.preventDefault();const slugs=selects.map((select)=>select.value).filter(Boolean);const state=buildComparisonSelection(slugs,contract);if(!state.valid||slugs.length<2){render(slugs,false);error.hidden=false;error.textContent=slugs.length<2?'Choisissez au moins deux logiciels.':'Sélection invalide.';return}const url=new URL(location.href);url.searchParams.set('software',slugs.join(','));history.pushState({},'',url);render(slugs,false)});
      selects.forEach((select)=>select.addEventListener('change',()=>{const selected=selects.map((item)=>item.value).filter(Boolean);selects.forEach((item)=>[...item.options].forEach((option)=>{option.disabled=Boolean(option.value&&selected.includes(option.value)&&item.value!==option.value)}))}));
      window.addEventListener('popstate',()=>render(new URL(location.href).searchParams.get('software')||''));render(new URL(location.href).searchParams.get('software')||'');
    }
  </script>
</BaseLayout>
