---
const path = Astro.url.pathname;
const links = [['/tests/','Tests'],['/comparatifs/','Comparatifs'],['/methodologie/','Méthodologie'],['/services/','Services'],['/a-propos/','À propos']];
---
<header class="site-header"><div class="shell nav-wrap">
  <a class="brand" href="/" aria-label="Datagraphe, accueil"><img src="/brand/datagraphe-logo.png" alt="" width="38" height="38" decoding="async" fetchpriority="high"/><span>Datagraphe</span></a>
  <button class="menu-button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button>
  <nav id="main-nav" aria-label="Navigation principale">{links.map(([href,label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}<a class="nav-cta" href="/tests/">Tous les tests</a></nav>
</div></header>
<script is:inline>const b=document.querySelector('.menu-button'),n=document.querySelector('#main-nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o)});</script>
