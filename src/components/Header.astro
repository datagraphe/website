---
import { locales, localeNames, localizedPath, type Locale } from '@/i18n/config';
import { t } from '@/i18n';
interface Props { locale: Locale; routePath: string }
const { locale, routePath } = Astro.props;
const tr = t(locale).common;
const path = Astro.url.pathname;
const links = [['tests',tr.tests],['comparatifs',tr.comparisons],['methodologie',tr.methodology],['services',tr.services],['a-propos',tr.about]];
---
<header class="site-header"><div class="shell nav-wrap">
  <a class="brand" href={localizedPath(locale)} aria-label={`Datagraphe — ${tr.home}`}><img src="/brand/datagraphe-logo.png" alt="" width="38" height="38" decoding="async" fetchpriority="high"/><span>Datagraphe</span></a>
  <button class="menu-button" aria-label={tr.menuOpen} data-label-open={tr.menuOpen} data-label-close={tr.menuClose} aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button>
  <nav id="main-nav" aria-label={tr.mainNav}>{links.map(([route,label]) => { const href=localizedPath(locale,route); return <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a> })}<a class="nav-cta" href={localizedPath(locale,'tests')}>{tr.allTests}</a><div class="language-switcher" aria-label={tr.language}>{locales.map(code => <a href={localizedPath(code,routePath)} lang={code} hreflang={code} aria-label={localeNames[code]} aria-current={code===locale ? 'page' : undefined}>{code.toUpperCase()}</a>)}</div></nav>
</div></header>
<script is:inline>const b=document.querySelector('.menu-button'),n=document.querySelector('#main-nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));b.setAttribute('aria-label',o?b.dataset.labelOpen:b.dataset.labelClose);n?.classList.toggle('open',!o)});</script>
