---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { localizedPath, type Locale } from '@/i18n/config';
import { t } from '@/i18n';
import { methodologyCopy } from '@/i18n/methodology';
import MethodFlow from '@/components/MethodFlow.astro';
import TestStatusLegend from '@/components/TestStatusLegend.astro';
import EvidenceMethod from '@/components/EvidenceMethod.astro';

interface Props { locale: Locale; routePath: string }
const { locale, routePath } = Astro.props;
const copy = methodologyCopy[locale];
const common = t(locale).common;
const statusClass = (code:string) => code.toLowerCase().replaceAll('_','-');
---

<BaseLayout locale={locale} routePath={routePath} title={copy.title} description={copy.description}>
  <header class="methodology-hero">
    <div class="shell methodology-hero-grid">
      <div>
        <Breadcrumb items={[{label:common.home,href:localizedPath(locale)},{label:common.methodology}]} ariaLabel={`${common.home} — ${common.methodology}`}/>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.heading}</h1>
        {copy.intro.map(paragraph => <p>{paragraph}</p>)}
        <div class="actions"><a class="button secondary" href={localizedPath(locale,'tests')}>{copy.testsCta}</a></div>
      </div>
      <div class="methodology-distinction" aria-label={copy.distinctions.join(', ')}>
        {copy.distinctions.map((item,index)=><div><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></div>)}
      </div>
    </div>
  </header>

  {locale === 'fr' && <section aria-labelledby="cycle-datagraphe"><div class="shell"><span class="eyebrow">Cycle Datagraphe</span><h2 id="cycle-datagraphe">De la fonction recensée à l’observation publiée</h2><p>Notre méthode suit huit étapes. Elle distingue ce que le logiciel annonce, ce que nous tentons, ce que nous observons et ce que la preuve autorise réellement à publier.</p><MethodFlow/></div></section>}

  <section class="methodology-why">
    <div class="shell split-section">
      <div><span class="eyebrow">Datagraphe</span><h2>{copy.why.heading}</h2>{copy.why.paragraphs.map(p=><p>{p}</p>)}<ul class="check-list">{copy.why.questions.map(item=><li>{item}</li>)}</ul></div>
      <div class="evidence-pipeline" aria-label={copy.why.pipeline.join(', ')}>{copy.why.pipeline.map((item,index)=><div><strong>{item}</strong>{index < (copy.why.pipeline.length - 1) && <span aria-hidden="true">↓</span>}</div>)}</div>
    </div>
  </section>

  <section class="soft methodology-protocol">
    <div class="shell"><div class="section-head"><div><span class="eyebrow">01 — 08</span><h2>{copy.protocolHeading}</h2></div></div>
      <div class="protocol-grid">{copy.steps.map((step,index)=><article class="protocol-card"><div class="protocol-number">{String(index+1).padStart(2,'0')}</div><h3>{step.title}</h3>{step.paragraphs.map(p=><p>{p}</p>)}{step.items&&<ul>{step.items.map(item=><li>{item}</li>)}</ul>}{step.example&&<div class="scenario-box">{step.example.map(row=><div><span>{row.label}</span><strong>{row.value}</strong></div>)}</div>}</article>)}</div>
    </div>
  </section>

  <section>
    <div class="shell"><div class="section-head"><div><span class="eyebrow">TESTED ≠ VISIBLE</span><h2>{copy.statusesHeading}</h2></div></div>
      <div class="methodology-status-grid">{copy.statuses.map(status=><article class={`methodology-status-card ${statusClass(status.code)}`}><span class={`status status-${statusClass(status.code)}`}>{status.code}</span><p>{status.text}</p>{status.example&&<small>{status.example}</small>}</article>)}</div>
    </div>
  </section>

  {locale === 'fr' && <section class="soft"><div class="shell"><div class="section-head"><div><span class="eyebrow">Vocabulaire de preuve</span><h2>Fonction, scénario, résultat et preuve ne désignent pas la même chose</h2></div></div><div class="foundation-principles"><article><h3>Une fonction n’est pas un scénario</h3><p>« Export CSV » est une fonction. Créer un rapport fictif, déclencher son export, ouvrir le fichier, vérifier ses colonnes puis recommencer après rechargement constitue un scénario.</p></article><article><h3>VERIFIED n’est pas synonyme de PASS</h3><p>VERIFIED signifie que la preuve est suffisante pour qualifier le résultat. Elle peut confirmer un PASS attendu ou un FAIL observé. INCONCLUSIVE reste préférable à une conclusion fragile.</p></article><article><h3>La persistance doit être contrôlée</h3><p>Action → enregistrement → changement de page ou rechargement → vérification. Une valeur seulement visible avant rechargement ne suffit pas.</p></article><article><h3>Nous recherchons les faux positifs</h3><p>Une interface peut donner l’impression qu’une action a réussi. Nous vérifions le résultat durable et conservons aussi les échecs lorsqu’ils sont correctement démontrés.</p></article></div><div style="margin-top:28px"><TestStatusLegend/></div><EvidenceMethod/></div></section>}

  {locale === 'fr' && <section><div class="shell two-panel"><article class="methodology-panel"><span class="eyebrow">Accès au logiciel</span><h2>Le contexte d’accès est toujours précisé</h2><ul class="check-list"><li>Forfait gratuit</li><li>Essai gratuit</li><li>Forfait payé par Datagraphe</li><li>Accès fourni par l’éditeur</li></ul><p>Un accès éditeur ne donne aucun contrôle sur le protocole, la formulation, la note ou le verdict.</p></article><article class="methodology-panel"><span class="eyebrow">Temps et versions</span><h2>Une observation est datée, pas éternelle</h2><p>Nos dossiers décrivent un produit, un environnement et un forfait à une date donnée. Des retests ciblés peuvent produire un nouvel état historique ; nous ne prétendons pas surveiller chaque logiciel en continu.</p><p>Une amélioration de notre protocole n’est pas présentée comme une évolution du produit testé.</p></article></div></section>}

  {locale === 'fr' && <section class="soft"><div class="shell two-panel"><article class="methodology-panel"><span class="eyebrow">Intelligence artificielle</span><h2>L’IA assiste le travail, elle ne remplace pas la preuve</h2><p>Elle peut aider à inventorier, structurer des scénarios, analyser des résultats et préparer une synthèse. Elle ne transforme jamais une documentation, une inférence ou une simple visibilité d’interface en test exécuté.</p></article><article class="methodology-panel"><span class="eyebrow">Confidentialité des preuves</span><h2>Les originaux restent privés</h2><p>Captures, exports et journaux complets sont conservés dans un espace privé. Nous publions seulement les informations nécessaires, anonymisées lorsque cela protège les données fictives, les comptes de test ou le fonctionnement interne.</p></article></div></section>}

  <section class="dark">
    <div class="shell coverage-grid"><div><span class="eyebrow">TESTED / PASS / FAIL</span><h2>{copy.coverage.heading}</h2>{copy.coverage.paragraphs.map(p=><p>{p}</p>)}</div><div class="coverage-example">{copy.coverage.labels.map((label,index)=><div><span>{label}</span><strong class={index>2?'coverage-code':''}>{copy.coverage.example[index]}</strong></div>)}</div></div>
  </section>

  <section>
    <div class="shell two-panel"><article class="methodology-panel"><span class="eyebrow">VISIBLE_NOT_TESTED</span><h2>{copy.paid.heading}</h2>{copy.paid.paragraphs.map(p=><p>{p}</p>)}<ol class="number-list">{copy.paid.checks.map(item=><li>{item}</li>)}</ol><p class="methodology-callout">{copy.paid.visible}</p></article><article class="methodology-panel limits-panel"><span class="eyebrow">NOT_TESTABLE</span><h2>{copy.limits.heading}</h2>{copy.limits.paragraphs.map(p=><p>{p}</p>)}<div class="tag-cloud">{copy.limits.items.map(item=><span>{item}</span>)}</div><blockquote><strong>{copy.limits.statement}</strong><br/>{copy.limits.explanation}</blockquote></article></div>
  </section>

  <section class="soft">
    <div class="shell scoring-grid"><div><span class="eyebrow">{copy.labels.scoring}</span><h2>{copy.scoring.heading}</h2>{copy.scoring.paragraphs.map(p=><p>{p}</p>)}<p class="methodology-callout">{copy.scoring.unscored}</p></div><div><div class="dimension-grid">{copy.scoring.dimensions.map(item=><span>{item}</span>)}</div><div class="score-requirements">{copy.scoring.requirements.map(item=><div><span aria-hidden="true">✓</span>{item}</div>)}</div></div></div>
  </section>

  <section>
    <div class="shell"><div class="section-head"><div><span class="eyebrow">{copy.labels.evidence}</span><h2>{copy.evidence.heading}</h2></div></div><div class="evidence-columns"><article class="evidence-card tested-evidence"><span class="status status-tested">TESTED</span><h3>{copy.evidence.testedTitle}</h3><blockquote>{copy.evidence.testedText}</blockquote><ul>{copy.evidence.testedUses.map(item=><li>{item}</li>)}</ul></article><article class="evidence-card documented-evidence"><span class="status status-unverified">DOCUMENTED</span><h3>{copy.evidence.documentedTitle}</h3><blockquote>{copy.evidence.documentedText}</blockquote><ul>{copy.evidence.documentedUses.map(item=><li>{item}</li>)}</ul></article></div><p class="centered-warning">{copy.evidence.warning}</p></div>
  </section>

  <section class="comparison-section">
    <div class="shell comparison-layout"><div><span class="eyebrow">VS</span><h2>{copy.comparison.heading}</h2>{copy.comparison.paragraphs.map(p=><p>{p}</p>)}<p class="methodology-callout">{copy.comparison.warning}</p></div><div class="comparison-board"><div class="versus"><strong>{copy.comparison.versus[0]}</strong><span>VS</span><strong>{copy.comparison.versus[1]}</strong></div><div class="comparison-dimensions">{copy.comparison.dimensions.map(item=><span>{item}</span>)}</div></div></div>
  </section>

  <section>
    <div class="shell use-case-layout"><div><span class="eyebrow">{copy.labels.useCases}</span><h2>{copy.useCases.heading}</h2>{copy.useCases.paragraphs.map(p=><p>{p}</p>)}</div><div class="use-case-tags">{copy.useCases.items.map(item=><span>{item}</span>)}</div></div><div class="shell"><blockquote class="editorial-quote">{copy.useCases.statement}</blockquote></div>
  </section>

  <section class="soft">
    <div class="shell two-panel"><article class="methodology-panel"><span class="eyebrow">{copy.labels.independence}</span><h2>{copy.funding.heading}</h2>{copy.funding.paragraphs.map(p=><p>{p}</p>)}<h3>≠</h3><ul class="check-list">{copy.funding.unaffected.map(item=><li>{item}</li>)}</ul><div class="tag-cloud">{copy.funding.outcomes.map(item=><span>{item}</span>)}</div><p><a class="text-link" href={localizedPath(locale,'transparence')}>{copy.funding.cta} →</a></p></article><article class="methodology-panel"><span class="eyebrow">Datagraphe Services</span><h2>{copy.services.heading}</h2>{copy.services.paragraphs.map(p=><p>{p}</p>)}<ul class="not-list">{copy.services.benefits.map(item=><li>{item}</li>)}</ul><p><a class="button secondary" href={localizedPath(locale,'services')}>{copy.services.cta}</a></p></article></div>
  </section>

  <section>
    <div class="shell version-layout"><div><span class="eyebrow">{copy.labels.dateVersion}</span><h2>{copy.versioning.heading}</h2>{copy.versioning.paragraphs.map(p=><p>{p}</p>)}<ul>{copy.versioning.updates.map(item=><li>{item}</li>)}</ul></div><div class="version-card">{copy.versioning.labels.map(label=><div><span>{label}</span><strong>—</strong></div>)}</div></div>
  </section>

  <section class="jibble-example">
    <div class="shell"><span class="eyebrow">{copy.jibble.eyebrow}</span><h2>{copy.jibble.heading}</h2><div class="jibble-observations">{copy.jibble.cards.map(card=><article><span class={`status status-${statusClass(card.code)}`}>{card.code}</span><h3>{card.title}</h3><p>{card.text}</p></article>)}</div><div class="actions"><a class="button primary" href={localizedPath(locale,'tests/jibble')}>{copy.jibble.cta}</a></div></div>
  </section>

  <section>
    <div class="shell proofs-layout"><div><span class="eyebrow">{copy.labels.traceability}</span><h2>{copy.proofs.heading}</h2>{copy.proofs.paragraphs.map(p=><p>{p}</p>)}</div><div class="proof-list">{copy.proofs.uses.map((item,index)=><div><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></div>)}</div></div>
  </section>

  <section class="methodology-final dark"><div class="shell"><h2>{copy.final.heading}</h2><p>{copy.final.text}</p><div class="final-distinction">{copy.final.distinctions.map(item=><strong>{item}</strong>)}</div><div class="actions"><a class="button primary" href={localizedPath(locale,'tests')}>{copy.final.testsCta}</a><a class="button dark-secondary" href={localizedPath(locale,'services')}>{copy.final.servicesCta}</a></div></div></section>
</BaseLayout>
