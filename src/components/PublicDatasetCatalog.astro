---
import { publicSoftware } from '@/data/public-contract';
const items=Object.values(publicSoftware);
---
<div class="software-catalog" data-source="public-dataset" data-schema="1.1"><div class="catalog-results"><div class="catalog-results-head"><p><strong>{items.length}</strong> logiciels testés</p><span class="catalog-current-category">Tous les tests</span></div><div class="software-grid">{items.map((item:any)=><article class="software-card" data-software-card data-category="gestion-du-temps" data-name={item.software.name.toLowerCase()} data-date={item.last_verified_at}><div class="software-card-top"><div class="software-monogram" aria-hidden="true">{item.software.name.slice(0,1)}</div><span class="catalog-status catalog-status-tested"><span></span>Testé</span></div><div class="software-card-body"><p class="software-category">Gestion du temps</p><h2>{item.software.name}</h2><p>{item.test_summary.tested} fonctionnalités testées sur {item.test_summary.total} · couverture {item.test_summary.coverage_rate.toFixed(1).replace('.',',')} %.</p></div><dl class="software-meta"><div><dt>Vérifié le</dt><dd>{item.last_verified_at}</dd></div><div><dt>Claims publiables</dt><dd>{item.claims.length}</dd></div></dl><a class="software-card-link" href={`/fr/tests/${item.software.slug}/`}>Voir le test<span aria-hidden="true">→</span></a></article>)}</div></div></div>
