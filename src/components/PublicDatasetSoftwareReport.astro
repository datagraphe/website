---
interface Props { data:any; software:string }
const {data,software}=Astro.props;const m=data.test_summary;const statusClass=(s:string)=>s.toLowerCase().replaceAll('_','-');
---
<section class="jibble-report-section" data-source="public-dataset" data-schema={data.public_schema_version}>
  <div class="shell test-layout"><article class="jibble-report">
    <section id="coverage"><h2>Couverture du protocole</h2><div class="jibble-coverage-summary"><div><strong>{m.total}</strong><span>Fonctionnalités</span></div><div><strong>{m.tested}</strong><span>TESTED</span></div><div><strong>{m.partial}</strong><span>PARTIAL</span></div><div><strong>{m.not_testable}</strong><span>NOT_TESTABLE</span></div><div><strong>{m.blocked}</strong><span>BLOCKED</span></div><div><strong>{m.not_available}</strong><span>NOT_AVAILABLE</span></div></div><p><strong>{m.coverage_rate.toFixed(1).replace('.',',')} %</strong> de couverture Datagraphe.</p></section>
    <section id="results"><h2>Résultats publics vérifiés</h2><div class="jibble-result-grid">{data.claims.map((claim:any)=><article><span class={`status status-${statusClass(claim.status)}`}>{claim.status}</span><h3>{claim.canonical_feature_key ?? 'Observation vérifiée'}</h3><p>{claim.localized.fr.wording}</p>{claim.localized.fr.qualifier&&<small class="jibble-caveat">Réserve : {claim.localized.fr.qualifier}</small>}</article>)}</div></section>
    <section id="limits"><h2>Limites documentées</h2><ul class="jibble-not-list">{data.limitations.map((item:any)=><li>{item.localized.fr.wording}</li>)}</ul></section>
    <section id="buyers"><h2>Contextes acheteurs</h2><div class="jibble-result-grid">{data.buyer_contexts.map((context:any)=><article><span class={`status status-${statusClass(context.status)}`}>{context.status}</span><h3>{context.localized.fr.label}</h3><p>{context.localized.fr.reason}</p>{context.localized.fr.limitations&&<small>Limites : {context.localized.fr.limitations}</small>}</article>)}</div></section>
    <section id="contract"><h2>Source et fraîcheur</h2><p>Contrat public Datagraphe 1.1 · snapshot {data.snapshot_selection.snapshot_id} · dernière vérification {data.last_verified_at}.</p><p>Aucun claim non publiable n’est rendu.</p><div class="actions"><a class="button secondary" href="/fr/tests/">Tous les tests</a><a class="button secondary" href="/fr/methodologie/">Méthodologie</a>{software !== 'Toggl Track' && <a class="button secondary" href="/fr/comparatifs/jibble-vs-clockify/">Jibble vs Clockify</a>}</div></section>
  </article><aside class="toc jibble-toc"><strong>{software}</strong><a href="#coverage">Couverture</a><a href="#results">Résultats</a><a href="#limits">Limites</a><a href="#buyers">Contextes acheteurs</a></aside></div>
</section>
