---
import { socials, type SocialPlatform } from '@/config/socials';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
const platforms: Array<{ key: SocialPlatform; label: string }> = [
  { key: 'youtube', label: 'YouTube' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'tiktok', label: 'TikTok' },
  { key: 'instagram', label: 'Instagram' },
];
---
<div class:list={['social-links', className]} aria-label="Réseaux sociaux Datagraphe">
  {platforms.map(({ key, label }) => {
    const url = socials[key];
    const accessibleLabel = `Datagraphe sur ${label}`;
    const icon = (
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {key === 'youtube' && <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />}
        {key === 'linkedin' && <path d="M20.5 3H3.5A2.5 2.5 0 0 0 1 5.5v13A2.5 2.5 0 0 0 3.5 21h17a2.5 2.5 0 0 0 2.5-2.5v-13A2.5 2.5 0 0 0 20.5 3ZM7.6 18H4.7V9.3h2.9V18ZM6.2 8.1a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4ZM19.3 18h-2.9v-4.2c0-1 0-2.3-1.4-2.3s-1.7 1.1-1.7 2.3V18h-2.9V9.3h2.8v1.2h.1A3 3 0 0 1 16 9c2.9 0 3.4 1.9 3.4 4.4V18Z" />}
        {key === 'tiktok' && <path d="M19.6 7.2a6.8 6.8 0 0 1-4-1.3v7.3a6.6 6.6 0 1 1-5.7-6.5v3.6a3.1 3.1 0 1 0 2.1 2.9V0h3.6c.3 2.3 1.8 3.7 4 4v3.2Z" />}
        {key === 'instagram' && <path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm-.2 2A3 3 0 0 0 4 7v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm10.5 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />}
      </svg>
    );
    return url ? (
      <a href={url} target="_blank" rel="noopener noreferrer" aria-label={accessibleLabel} title={label}>{icon}</a>
    ) : (
      <span class="social-link-unconfigured" role="img" aria-label={`${accessibleLabel} — lien à venir`} title={`${label} — lien à venir`}>{icon}</span>
    );
  })}
</div>
