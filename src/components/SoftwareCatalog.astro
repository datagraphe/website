---
import type { Locale } from '@/i18n/config';
import { categoryById, categoryLabel, softwareCategories } from '@/data/software-categories';
import { testedSoftwareForLocale } from '@/data/software';
import { catalogCopy } from '@/i18n/catalog';
import CategoryIcon from './CategoryIcon.astro';
import SoftwareTestCard from './SoftwareTestCard.astro';

interface Props { locale:Locale }
const { locale } = Astro.props;
const copy = catalogCopy[locale];
const testedSoftware = testedSoftwareForLocale(locale);
const categories = [...softwareCategories].sort((a,b)=>a.sort_order-b.sort_order);
const countFor = (id:string) => id === 'all' ? testedSoftware.length : testedSoftware.filter((software)=>software.category===id).length;
const hasScores = testedSoftware.some((software)=>software.score !== null);
---
<div class="software-catalog" data-software-catalog data-locale={locale} data-one={copy.result} data-many={copy.results}>
  <div class="catalog-toolbar">
    <label class="catalog-search"><span class="visually-hidden">{copy.searchLabel}</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><input type="search" placeholder={copy.search} autocomplete="off" data-software-search/></label>
    <label class="catalog-sort"><span>{copy.sortLabel}</span><select data-software-sort><option value="recent">{copy.recent}</option><option value="name">{copy.nameAZ}</option><option value="score" disabled={!hasScores}>{copy.score}{!hasScores ? ` — ${copy.scoreUnavailable}` : ''}</option></select></label>
  </div>

  <details class="catalog-mobile-filter">
    <summary>{copy.mobileFilter}<span data-mobile-category>{categoryLabel(categories[0],locale)}</span></summary>
    <div class="catalog-filter-list" aria-label={copy.categoryNav}>
      {categories.map((category)=>{const count=countFor(category.id);return <button type="button" data-category={category.id} data-category-label={categoryLabel(category,locale)} aria-pressed={category.id==='all'}><CategoryIcon name={category.icon}/><span class="category-button-copy"><strong>{categoryLabel(category,locale)}</strong><small>{count ? `${count} ${count===1?copy.oneSoftware:copy.manySoftware}` : copy.preparing}</small></span><span class="category-count">{count}</span></button>})}
    </div>
  </details>

  <div class="catalog-layout">
    <aside class="catalog-sidebar" aria-label={copy.categoryNav}>
      <div class="catalog-filter-list">
        {categories.map((category)=>{const count=countFor(category.id);return <button type="button" data-category={category.id} data-category-label={categoryLabel(category,locale)} aria-pressed={category.id==='all'}><CategoryIcon name={category.icon}/><span class="category-button-copy"><strong>{categoryLabel(category,locale)}</strong><small>{count ? `${count} ${count===1?copy.oneSoftware:copy.manySoftware}` : copy.preparing}</small></span><span class="category-count">{count}</span></button>})}
      </div>
    </aside>

    <div class="catalog-results">
      <div class="catalog-results-head"><p><strong data-result-count>{testedSoftware.length}</strong> <span data-result-label>{testedSoftware.length===1?copy.result:copy.results}</span></p><span class="catalog-current-category" data-current-category>{categoryLabel(categories[0],locale)}</span></div>
      <div class="software-grid" data-software-grid>
        {testedSoftware.map((software)=>{const category=categoryById.get(software.category);return category && <SoftwareTestCard software={software} category={category} locale={locale} copy={copy}/>})}
      </div>
      <div class="catalog-empty" data-catalog-empty hidden>
        <div class="empty-mark" aria-hidden="true"><span></span><span></span><span></span></div>
        <h2 data-empty-title>{copy.emptyTitle}</h2><p data-empty-text>{copy.emptyText}</p>
        <button class="button secondary" type="button" data-view-all>{copy.viewAll}</button>
      </div>
    </div>
  </div>
</div>
<script is:inline define:vars={{emptyCategoryTitle:copy.emptyTitle,emptyCategoryText:copy.emptyText,emptySearchTitle:copy.emptySearchTitle,emptySearchText:copy.emptySearchText}}>
  document.querySelectorAll('[data-software-catalog]').forEach((catalog)=>{
    const cards=[...catalog.querySelectorAll('[data-software-card]')],buttons=[...catalog.querySelectorAll('[data-category]')],grid=catalog.querySelector('[data-software-grid]'),search=catalog.querySelector('[data-software-search]'),sort=catalog.querySelector('[data-software-sort]'),empty=catalog.querySelector('[data-catalog-empty]'),count=catalog.querySelector('[data-result-count]'),countLabel=catalog.querySelector('[data-result-label]'),current=catalog.querySelector('[data-current-category]'),mobileCurrent=catalog.querySelector('[data-mobile-category]'),mobileDetails=catalog.querySelector('.catalog-mobile-filter');
    let activeCategory='all';
    const normalize=(value)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase(catalog.dataset.locale);
    const render=()=>{
      const query=normalize(search.value.trim());
      const visible=cards.filter(card=>(activeCategory==='all'||card.dataset.category===activeCategory)&&normalize(card.dataset.name).includes(query));
      cards.forEach(card=>card.hidden=!visible.includes(card));
      const ordered=[...visible].sort((a,b)=>sort.value==='name'?a.dataset.name.localeCompare(b.dataset.name,catalog.dataset.locale):sort.value==='score'?(Number(b.dataset.score||-1)-Number(a.dataset.score||-1)||a.dataset.name.localeCompare(b.dataset.name,catalog.dataset.locale)):(Date.parse(b.dataset.date||'1970-01-01')-Date.parse(a.dataset.date||'1970-01-01')||a.dataset.name.localeCompare(b.dataset.name,catalog.dataset.locale)));
      ordered.forEach(card=>grid.append(card));
      count.textContent=String(visible.length);countLabel.textContent=visible.length===1?catalog.dataset.one:catalog.dataset.many;
      empty.hidden=visible.length!==0;grid.hidden=visible.length===0;
      empty.querySelector('[data-empty-title]').textContent=query?emptySearchTitle:emptyCategoryTitle;
      empty.querySelector('[data-empty-text]').textContent=query?emptySearchText:emptyCategoryText;
    };
    const selectCategory=(button)=>{
      activeCategory=button.dataset.category;
      buttons.forEach(item=>item.setAttribute('aria-pressed',String(item.dataset.category===activeCategory)));
      current.textContent=button.dataset.categoryLabel;mobileCurrent.textContent=button.dataset.categoryLabel;
      if(mobileDetails?.open)mobileDetails.open=false;
      render();
    };
    buttons.forEach(button=>button.addEventListener('click',()=>selectCategory(button)));
    search.addEventListener('input',render);sort.addEventListener('change',render);
    empty.querySelector('[data-view-all]').addEventListener('click',()=>{search.value='';selectCategory(buttons.find(button=>button.dataset.category==='all'))});
    render();
  });
</script>
