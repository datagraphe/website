---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { locales, localeTags, ogLocales, localizedPath, type Locale } from '@/i18n/config';
import { t } from '@/i18n';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/services.css';
import '../styles/socials.css';
import '../styles/catalog.css';
import '../styles/methodology.css';
import '../styles/services-landing.css';
import '../styles/jibble-report.css';
interface Props { locale?: Locale; routePath?: string; title: string; description: string; image?: string; noindex?: boolean; ogTitle?: string; ogDescription?: string }
const fallbackRoute = Astro.url.pathname.replace(/^\/+|\/+$/g,'');
const { locale = 'fr', routePath = fallbackRoute, title, description, image='/brand/datagraphe-logo.png', noindex=false, ogTitle=title, ogDescription=description } = Astro.props;
const canonical = new URL(localizedPath(locale,routePath), Astro.site);
const social = new URL(image, Astro.site);
const structuredData = {'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://datagraphe.com/#organization',name:'Datagraphe',url:'https://datagraphe.com/',logo:{'@type':'ImageObject',url:'https://datagraphe.com/brand/datagraphe-logo.png',width:1254,height:1254}},{'@type':'WebSite','@id':`https://datagraphe.com/${locale}/#website`,url:new URL(localizedPath(locale),Astro.site).href,name:'Datagraphe',description:t(locale).common.footerText,publisher:{'@id':'https://datagraphe.com/#organization'},inLanguage:localeTags[locale]}]};
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#071326"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{locales.map(code=><link rel="alternate" hreflang={code} href={new URL(localizedPath(code,routePath),Astro.site)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(localizedPath('fr',routePath),Astro.site)}/><link rel="icon" href="/brand/favicon.png" type="image/png"/><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}/><meta property="og:type" content="website"/><meta property="og:locale" content={ogLocales[locale]}/><meta property="og:site_name" content="Datagraphe"/><meta property="og:title" content={ogTitle}/><meta property="og:description" content={ogDescription}/><meta property="og:url" content={canonical}/><meta property="og:image" content={social}/><meta property="og:image:alt" content="Datagraphe"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={ogTitle}/><meta name="twitter:description" content={ogDescription}/><meta name="twitter:image" content={social}/><meta name="twitter:image:alt" content="Datagraphe"/><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/></head><body data-locale={locale}><a class="skip" href="#contenu">{t(locale).common.skip}</a><Header locale={locale} routePath={routePath}/><main id="contenu"><slot/></main><Footer locale={locale}/></body></html>
