---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
interface Props { title: string; description: string; eyebrow: string; h1: string; lead: string; problem: string; solution: string; steps: string[]; example: string; deliverables: string[]; audience: string; needs: string[]; faq: {q:string,a:string}[] }
const p = Astro.props;
const schema={'@context':'https://schema.org','@type':'Service',name:p.h1,provider:{'@type':'Organization',name:'Datagraphe',url:'https://datagraphe.com'},areaServed:'France',audience:{'@type':'Audience',audienceType:'TPE, PME et éditeurs de logiciels'},description:p.description};
---
<BaseLayout title={p.title} description={p.description}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><header class="service-hero"><div class="shell"><Breadcrumb items={[{label:'Accueil',href:'/'},{label:'Services',href:'/services/'},{label:p.h1}]}/><span class="eyebrow">{p.eyebrow}</span><h1>{p.h1}</h1><p>{p.lead}</p><a class="button primary" href="/contact/">Parler de votre projet</a></div></header><section><div class="shell service-detail-grid"><article><h2>Le problème</h2><p>{p.problem}</p><h2>La solution Datagraphe</h2><p>{p.solution}</p><h2>Comment cela fonctionne</h2><ol class="step-list">{p.steps.map((step,i)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{step}</p></li>)}</ol><h2>Exemple concret</h2><div class="example-box"><span>Scénario d’exemple</span><p>{p.example}</p></div></article><aside><div class="side-card"><h2>Livrables possibles</h2><ul>{p.deliverables.map(x=><li>{x}</li>)}</ul></div><div class="side-card"><h2>Pour qui ?</h2><p>{p.audience}</p></div><div class="side-card"><h2>Pour commencer</h2><ul>{p.needs.map(x=><li>{x}</li>)}</ul></div></aside></div></section><section class="soft"><div class="content"><h2>Questions fréquentes</h2><div class="faq">{p.faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div><div class="service-cta"><h2>Parlons de votre logiciel.</h2><p>Décrivez votre contexte, vos outils et le résultat attendu. Nous vérifierons d’abord la faisabilité.</p><a class="button primary" href="/contact/">Parler de votre projet</a></div></div></section></BaseLayout>
