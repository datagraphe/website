---
import '../styles/global.css';
import '../styles/brand.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#071326" />
    <link rel="icon" href="/brand/favicon.png" type="image/png" />
    <title>Page introuvable — Datagraphe</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" data-home href="/fr/" aria-label="Datagraphe">
          <img src="/brand/datagraphe-logo.png" alt="" width="38" height="38" />
          <span>Datagraphe</span>
        </a>
      </div>
    </header>
    <main>
      <header class="page-hero">
        <div class="shell">
          <span class="eyebrow" data-eyebrow>Erreur 404</span>
          <h1 data-heading>Cette page reste introuvable.</h1>
          <p data-message>Le lien est peut-être incomplet ou la page a été déplacée.</p>
          <div class="actions">
            <a class="button primary" data-home data-home-label href="/fr/">Retour à l’accueil</a>
            <a class="button secondary" data-tests href="/fr/tests/">Voir les tests</a>
          </div>
        </div>
      </header>
    </main>
    <script is:inline>
      const copy = {
        fr: { title: 'Page introuvable — Datagraphe', eyebrow: 'Erreur 404', heading: 'Cette page reste introuvable.', message: 'Le lien est peut-être incomplet ou la page a été déplacée.', home: 'Retour à l’accueil', tests: 'Voir les tests' },
        en: { title: 'Page not found — Datagraphe', eyebrow: 'Error 404', heading: 'This page could not be found.', message: 'The link may be incomplete or the page may have moved.', home: 'Back to home', tests: 'View the tests' },
        de: { title: 'Seite nicht gefunden — Datagraphe', eyebrow: 'Fehler 404', heading: 'Diese Seite wurde nicht gefunden.', message: 'Der Link ist möglicherweise unvollständig oder die Seite wurde verschoben.', home: 'Zur Startseite', tests: 'Tests ansehen' },
        it: { title: 'Pagina non trovata — Datagraphe', eyebrow: 'Errore 404', heading: 'Questa pagina non è stata trovata.', message: 'Il link potrebbe essere incompleto o la pagina potrebbe essere stata spostata.', home: 'Torna alla home', tests: 'Vedi i test' },
        es: { title: 'Página no encontrada — Datagraphe', eyebrow: 'Error 404', heading: 'No se ha encontrado esta página.', message: 'El enlace puede estar incompleto o la página puede haber cambiado de ubicación.', home: 'Volver al inicio', tests: 'Ver las pruebas' },
      };
      const requested = location.pathname.split('/')[1];
      const locale = Object.hasOwn(copy, requested) ? requested : 'fr';
      const text = copy[locale];
      document.documentElement.lang = locale;
      document.title = text.title;
      document.querySelector('[data-eyebrow]').textContent = text.eyebrow;
      document.querySelector('[data-heading]').textContent = text.heading;
      document.querySelector('[data-message]').textContent = text.message;
      document.querySelector('[data-home-label]').textContent = text.home;
      document.querySelector('[data-tests]').textContent = text.tests;
      document.querySelectorAll('[data-home]').forEach((link) => link.href = `/${locale}/`);
      document.querySelector('[data-tests]').href = `/${locale}/tests/`;
    </script>
  </body>
</html>
