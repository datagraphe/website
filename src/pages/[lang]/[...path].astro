---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import MethodologyCard from '@/components/MethodologyCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import SoftwareCatalog from '@/components/SoftwareCatalog.astro';
import SoftwareTestCard from '@/components/SoftwareTestCard.astro';
import MethodologyPage from '@/components/MethodologyPage.astro';
import { locales, localizedPath, localeTags, type Locale } from '@/i18n/config';
import { routes, type RouteDefinition } from '@/i18n/routes';
import { t } from '@/i18n';
import { catalogCopy } from '@/i18n/catalog';
import { categoryById } from '@/data/software-categories';
import { testedSoftware } from '@/data/software';
import jibble from '@/data/software/jibble.json';

export function getStaticPaths() {
  return locales.flatMap((locale) => routes.map((route) => ({
    params: { lang: locale, path: route.path || undefined },
    props: { locale, route },
  })));
}

interface Props { locale: Locale; route: RouteDefinition }
const { locale, route } = Astro.props;
const content = t(locale);
const common = content.common;
const catalog = catalogCopy[locale];
const page = route.kind === 'standard' ? content.pages[route.key] : undefined;
const routePath = route.path;
const featuredSoftware = testedSoftware.slice(0,1);

const crumbItems = route.path.includes('/')
  ? [{label:common.home,href:localizedPath(locale)},{label:route.path.startsWith('services/')?common.services:common.tests,href:localizedPath(locale,route.path.split('/')[0])},{label:page?.heading || content.jibble.heading}]
  : [{label:common.home,href:localizedPath(locale)},{label:page?.heading || content.home.heading}];

const serviceKeys = ['integration','regression','migration','monitoring'];
const serviceRoutes = ['services/integration-logiciels','services/tests-regression','services/controle-migration','services/surveillance-logiciel'];
const softwareSchema = {'@context':'https://schema.org','@type':'SoftwareApplication',name:'Jibble',url:'https://www.jibble.io',applicationCategory:'BusinessApplication',applicationSubCategory:content.jibble.category,operatingSystem:'Web',description:content.jibble.description,inLanguage:localeTags[locale]};
---

{route.kind === 'home' && <BaseLayout locale={locale} routePath="" title={content.home.title} description={content.home.description}>
  <section class="hero"><div class="shell hero-grid"><div><span class="eyebrow">{content.home.eyebrow}</span><h1>{content.home.heading}</h1><p>{content.home.lead}</p><p class="brand-signature">{content.home.signature}</p><div class="actions"><a class="button primary" href={localizedPath(locale,'tests')}>{content.home.testsCta}</a><a class="button secondary" href={localizedPath(locale,'methodologie')}>{content.home.methodologyCta}</a></div></div><div class="hero-visual" aria-hidden="true"><div class="software-sheet"><div class="dot"></div><div class="line"></div><div class="line short"></div><div class="line"></div></div><div class="software-sheet"><div class="dot"></div><div class="line short"></div><div class="line"></div><div class="line"></div></div><div class="lens"></div><div class="check"></div></div></div></section>
  <section><div class="shell"><div class="section-head"><div><span class="eyebrow">{content.home.methodEyebrow}</span><h2>{content.home.methodHeading}</h2></div><p>{content.home.methodLead}</p></div><div class="method-grid">{content.home.methods.map((method,index)=><MethodologyCard number={String(index+1).padStart(2,'0')} title={method.title}><p>{method.text}</p></MethodologyCard>)}</div></div></section>
  <section class="services-band"><div class="shell"><div class="section-head"><div><span class="eyebrow">{content.home.servicesEyebrow}</span><h2>{content.home.servicesHeading}</h2></div><p>{content.home.servicesLead}</p></div><div class="services-grid">{serviceKeys.map((key,index)=>{const item=content.pages[key];return <ServiceCard number={String(index+1).padStart(2,'0')} title={item.heading} text={item.lead||item.description} href={localizedPath(locale,serviceRoutes[index])} cta={common.readMore}/>})}</div><div class="actions"><a class="button primary" href={localizedPath(locale,'services')}>{common.services}</a></div></div></section>
  <section class="soft"><div class="shell test-feature"><div><span class="eyebrow">{catalog.homeEyebrow}</span><h2>{catalog.homeHeading}</h2><p>{catalog.homeText}</p><div class="actions"><a class="button primary" href={localizedPath(locale,'tests')}>{catalog.homeCta}</a></div></div><div class="catalog-home-card">{featuredSoftware.map((software)=>{const category=categoryById.get(software.category);return category && <SoftwareTestCard software={software} category={category} locale={locale} copy={catalog}/>})}</div></div></section>
  <section><div class="shell"><div class="section-head"><div><span class="eyebrow">{content.home.fieldEyebrow}</span><h2>{content.home.fieldHeading}</h2></div><p>{content.home.fieldText}</p></div></div></section>
  <section class="dark"><div class="shell promise-grid"><div class="section-head"><div><span class="eyebrow">{content.home.promiseEyebrow}</span><h2>{content.home.promiseHeading}</h2><p>{content.home.promiseText}</p></div></div><div class="status-list">{['TESTED','PARTIAL','NOT_TESTABLE','BLOCKED','NOT_AVAILABLE'].map(status=><div class="status-row"><span>{content.jibble.statusLabels[status]}</span><span class={`status status-${status.toLowerCase().replace('_','-')}`}>{status}</span></div>)}</div></div></section>
  <section class="social-section"><div class="shell social-section-inner"><div><span class="eyebrow">{common.follow}</span><h2>{common.follow}</h2><p>{common.followText}</p></div><SocialLinks locale={locale} class="social-links-home" /></div></section>
</BaseLayout>}

{route.kind === 'catalog' && <BaseLayout locale={locale} routePath={routePath} title={catalog.title} description={catalog.description}>
  <header class="page-hero catalog-hero"><div class="shell"><Breadcrumb items={[{label:common.home,href:localizedPath(locale)},{label:catalog.heading}]} ariaLabel={`${common.home} — ${catalog.heading}`}/><span class="eyebrow">{catalog.eyebrow}</span><h1>{catalog.heading}</h1><p>{catalog.lead}</p><span class="catalog-intro-number">{testedSoftware.length} {testedSoftware.length===1?catalog.oneSoftware:catalog.manySoftware}</span></div></header>
  <section class="catalog-section"><div class="shell"><SoftwareCatalog locale={locale}/></div></section>
  <section class="catalog-proof"><div class="shell catalog-proof-inner"><div><span class="eyebrow">Datagraphe</span><h2>{catalog.methodologyTitle}</h2><p>{catalog.methodologyText}</p></div><div class="actions"><a class="button primary" href={localizedPath(locale,'methodologie')}>{catalog.methodologyCta}</a><a class="button secondary" href={localizedPath(locale,'services')}>{catalog.servicesCta}</a></div></div></section>
</BaseLayout>}

{route.kind === 'standard' && route.key === 'methodologie' && <MethodologyPage locale={locale} routePath={routePath}/>} 

{route.kind === 'standard' && route.key !== 'methodologie' && page && <BaseLayout locale={locale} routePath={routePath} title={page.title} description={page.description} noindex={!route.indexable}>
  <header class="page-hero"><div class="shell"><Breadcrumb items={crumbItems} ariaLabel={`${common.home} — ${page.heading}`}/>{page.eyebrow && <span class="eyebrow">{page.eyebrow}</span>}<h1>{page.heading}</h1>{page.lead && <p>{page.lead}</p>}</div></header>
  <section><article class="content">{page.sections.map(section=><section class="localized-content-section"><h2>{section.heading}</h2>{section.paragraphs?.map(paragraph=><p>{paragraph}</p>)}{section.items && <ul>{section.items.map(item=><li>{item}</li>)}</ul>}</section>)}
    {route.key==='services' && <div class="services-grid localized-services">{serviceKeys.map((key,index)=>{const item=content.pages[key];return <ServiceCard number={String(index+1).padStart(2,'0')} title={item.heading} text={item.lead||item.description} href={localizedPath(locale,serviceRoutes[index])} cta={common.readMore}/>})}</div>}
    {serviceKeys.includes(route.key) && <p><a class="button primary" href={localizedPath(locale,'contact')}>{common.contactCta}</a></p>}
  </article></section>
</BaseLayout>}

{route.kind === 'jibble' && <BaseLayout locale={locale} routePath={routePath} title={content.jibble.title} description={content.jibble.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)}/><header class="page-hero"><div class="shell"><Breadcrumb items={crumbItems} ariaLabel={`${common.tests} — Jibble`}/><div><span class="status status-partial">Datagraphe Test</span> <span class="status">{content.jibble.category}</span></div><h1>{content.jibble.heading}</h1><p>{content.jibble.question}</p></div></header>
  <section><div class="shell test-layout"><article class="content" style="width:auto"><div id="verdict" class="verdict-box"><span class="eyebrow">{content.jibble.verdictEyebrow}</span><h2>{content.jibble.verdictHeading}</h2><p>{content.jibble.verdictText}</p><span class="status status-partial">{content.jibble.partial}</span></div><h2 id="protocol">{content.jibble.protocolHeading}</h2><p>{content.jibble.protocolText}</p><p><a href={localizedPath(locale,'methodologie')}>{content.jibble.methodologyLink}</a>.</p><div class="two-col"><div><h3>{content.jibble.testedHeading}</h3><div class="placeholder">{content.jibble.testedPlaceholder}</div></div><div><h3>{content.jibble.notTestedHeading}</h3><div class="placeholder">{content.jibble.notTestedPlaceholder}</div></div></div><h2>{content.jibble.audienceHeading}</h2><div class="placeholder">{content.jibble.audiencePlaceholder}</div><h2>{content.jibble.avoidHeading}</h2><div class="placeholder">{content.jibble.avoidPlaceholder}</div><h2 id="features">{content.jibble.featuresHeading}</h2><div class="feature-grid">{jibble.features.map(feature=><article class="feature-card" data-claim-id={feature.claim_id}><h3>{content.jibble.features[feature.key]}</h3><span class="status status-unverified">{content.jibble.statusLabels[feature.status]}</span><p>{content.jibble.featurePending}</p></article>)}</div><h2>{content.jibble.prosConsHeading}</h2><div class="two-col"><div class="placeholder"><strong>{content.jibble.pros}</strong><p>{content.jibble.pending}</p></div><div class="placeholder"><strong>{content.jibble.cons}</strong><p>{content.jibble.pending}</p></div></div><h2>{content.jibble.sourcesHeading}</h2><ul><li><a href="https://www.jibble.io/help/using-jibbles-api-for-your-specific-needs">Jibble API</a></li><li><a href="https://www.jibble.io/help/how-is-my-bill-calculated">Jibble billing</a></li></ul><p>{content.jibble.sourcesText}</p><h2>{content.jibble.alternativesHeading}</h2><p>{content.jibble.alternativesText}</p><h2>{content.jibble.faqHeading}</h2><div class="faq">{content.jibble.faqs.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div><h2>{content.jibble.finalHeading}</h2><div class="placeholder">{content.jibble.finalText}</div><aside class="disclosure" style="margin-top:32px"><strong>{content.jibble.disclosureTitle}</strong><p>{content.jibble.disclosureText}</p></aside></article><aside class="toc"><strong>{content.jibble.toc}</strong><a href="#verdict">{content.jibble.verdictEyebrow}</a><a href="#protocol">{content.jibble.protocolHeading}</a><a href="#features">{content.jibble.featuresHeading}</a></aside></div></section>
</BaseLayout>}
