---
import BaseLayout from '@/layouts/BaseLayout.astro'; import MethodologyCard from '@/components/MethodologyCard.astro'; import CategoryCard from '@/components/CategoryCard.astro'; import StatusBadge from '@/components/StatusBadge.astro';
const cats=[['Gestion du temps','◷'],['CRM','◎'],['Gestion de projet','◇'],['Marketing','↗'],['Vente','△'],['Comptabilité','≡'],['RH','○'],['Productivité','✦']];
---
<BaseLayout title="Datagraphe — Tests et comparatifs de logiciels" description="Datagraphe teste et compare les logiciels pour vous aider à choisir les outils adaptés à votre entreprise. Tests documentés, limites et alternatives.">
<section class="hero"><div class="shell hero-grid"><div><span class="eyebrow">Tests • Comparatifs • Logiciels</span><h1>Les logiciels méritent d’être testés avant d’être choisis.</h1><p>Datagraphe analyse les outils professionnels dans des environnements de test documentés. Nous distinguons ce qui a été réellement manipulé, ce qui reste partiel et ce qui ne peut pas être vérifié.</p><div class="actions"><a class="button primary" href="/tests/">Voir les tests</a><a class="button secondary" href="/methodologie/">Notre méthodologie</a></div></div><div class="hero-visual" aria-hidden="true"><div class="software-sheet"><div class="dot"></div><div class="line"></div><div class="line short"></div><div class="line"></div></div><div class="software-sheet"><div class="dot"></div><div class="line short"></div><div class="line"></div><div class="line"></div></div><div class="lens"></div><div class="check"></div></div></div></section>
<section><div class="shell"><div class="section-head"><div><span class="eyebrow">La méthode Datagraphe</span><h2>Observer avant d’affirmer.</h2></div><p>Une grille de lecture conçue pour séparer les promesses marketing des résultats réellement constatés.</p></div><div class="method-grid"><MethodologyCard number="01" title="Tester"><p>Créer un environnement fictif et exécuter des scénarios d’usage concrets.</p></MethodologyCard><MethodologyCard number="02" title="Vérifier"><p>Qualifier chaque résultat : vérifié, partiel, non vérifié ou contredit.</p></MethodologyCard><MethodologyCard number="03" title="Documenter"><p>Conserver les menus, exports, résultats observés et preuves pertinentes.</p></MethodologyCard><MethodologyCard number="04" title="Comparer"><p>Appliquer le même cadre aux alternatives pour une comparaison utile.</p></MethodologyCard></div></div></section>
<section class="soft"><div class="shell test-feature"><div><span class="eyebrow">Premier dossier</span><h2>Jibble, sous le regard du protocole Datagraphe.</h2><p>Le suivi du temps, les feuilles de temps, les rapports et les fonctions avancées font l’objet d’un examen structuré. Le dossier éditorial est en cours de finalisation.</p><div class="actions"><a class="button primary" href="/tests/jibble/">Découvrir le dossier</a></div></div><div class="test-panel"><StatusBadge status="partial" label="Test en cours de finalisation"/><h3>Jibble</h3><p>Gestion du temps · Dossier Datagraphe en préparation</p></div></div></section>
<section><div class="shell"><div class="section-head"><div><span class="eyebrow">Champ d’analyse</span><h2>Les catégories que nous allons tester.</h2></div><p>Un catalogue éditorial construit progressivement, sans faux volume ni notation prématurée.</p></div><div class="category-grid">{cats.map(([name,icon])=><CategoryCard name={name} icon={icon}/>)}</div></div></section>
<section class="dark"><div class="shell promise-grid"><div class="section-head"><div><span class="eyebrow">Promesse éditoriale</span><h2>Voir une fonction n’est pas la tester.</h2><p>Chaque conclusion doit pouvoir être rattachée à une action et à un résultat observé. Quand le test s’arrête, nous le disons.</p></div></div><div class="status-list"><div class="status-row"><span>Action exécutée et résultat observé</span><StatusBadge status="tested"/></div><div class="status-row"><span>Scénario incomplet ou preuve limitée</span><StatusBadge status="partial"/></div><div class="status-row"><span>Contexte matériel ou externe requis</span><StatusBadge status="not-testable"/></div><div class="status-row"><span>Affirmation encore sans preuve</span><StatusBadge status="unverified"/></div></div></div></section>
</BaseLayout>
