---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MethodologyCard from '@/components/MethodologyCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
const cats=[['Gestion du temps','◷','/categories/gestion-du-temps/'],['CRM','◎',''],['Gestion de projet','◇',''],['Marketing','↗',''],['Vente','△',''],['Comptabilité','≡',''],['RH','○',''],['Productivité','✦','']];
---
<BaseLayout title="Datagraphe — Tests et comparatifs de logiciels pour TPE & PME" description="Datagraphe teste et compare les logiciels pour indépendants, TPE et PME. Tests documentés, limites, alternatives et comparatifs pour choisir plus facilement vos logiciels." ogTitle="Datagraphe — Tests de logiciels pour TPE & PME" ogDescription="Des logiciels réellement testés, leurs limites documentées et leurs alternatives pour aider les TPE et PME à mieux choisir.">
  <section class="hero"><div class="shell hero-grid"><div><span class="eyebrow">Tests • Comparatifs • Logiciels</span><h1>Les logiciels pour TPE et PME méritent d’être testés avant d’être choisis.</h1><p>Datagraphe teste les logiciels, vérifie leurs fonctions et documente leurs limites pour aider les indépendants, TPE et PME à choisir les bons outils.</p><p class="brand-signature">Nous testons les logiciels avant que vous perdiez du temps à les tester.</p><div class="actions"><a class="button primary" href="/tests/">Voir les tests</a><a class="button secondary" href="/methodologie/">Notre méthodologie</a></div></div><div class="hero-visual" aria-hidden="true"><div class="software-sheet"><div class="dot"></div><div class="line"></div><div class="line short"></div><div class="line"></div></div><div class="software-sheet"><div class="dot"></div><div class="line short"></div><div class="line"></div><div class="line"></div></div><div class="lens"></div><div class="check"></div></div></div></section>
  <section><div class="shell"><div class="section-head"><div><span class="eyebrow">La méthode Datagraphe</span><h2>Observer avant d’affirmer.</h2></div><p>Une grille de lecture conçue pour séparer les promesses marketing des résultats réellement constatés.</p></div><div class="method-grid"><MethodologyCard number="01" title="Tester"><p>Créer un environnement fictif et exécuter des scénarios d’usage concrets.</p></MethodologyCard><MethodologyCard number="02" title="Vérifier"><p>Qualifier chaque résultat : vérifié, partiel, non vérifié ou contredit.</p></MethodologyCard><MethodologyCard number="03" title="Documenter"><p>Conserver les menus, exports, résultats observés et preuves pertinentes.</p></MethodologyCard><MethodologyCard number="04" title="Comparer"><p>Appliquer le même cadre aux alternatives pour une comparaison utile.</p></MethodologyCard></div></div></section>
  <section class="services-band"><div class="shell"><div class="section-head"><div><span class="eyebrow">Datagraphe Services</span><h2>Automatisez vos logiciels. Sécurisez vos évolutions.</h2></div><p>Datagraphe accompagne les TPE, PME et éditeurs dans l’intégration de leurs logiciels, l’automatisation des processus et la vérification des nouvelles versions.</p></div><div class="services-grid"><ServiceCard number="01" title="Intégration de logiciels" text="Faites communiquer vos logiciels automatiquement et supprimez les ressaisies manuelles." href="/services/integration-logiciels/" cta="Découvrir les intégrations"/><ServiceCard number="02" title="Tests de régression automatisés" text="Vérifiez automatiquement qu’une nouvelle version n’a pas cassé une fonctionnalité existante." href="/services/tests-regression/" cta="Automatiser mes tests"/><ServiceCard number="03" title="Contrôle de migration de données" text="Vérifiez que vos données ont été correctement transférées lors d’un changement de logiciel." href="/services/controle-migration/" cta="Sécuriser une migration"/><ServiceCard number="04" title="Surveillance fonctionnelle" text="Vérifiez que les fonctions métier de votre logiciel fonctionnent encore, pas seulement que le site répond." href="/services/surveillance-logiciel/" cta="Surveiller mon logiciel"/></div><div class="actions"><a class="button primary" href="/services/">Découvrir Datagraphe Services</a></div></div></section>
  <section class="soft"><div class="shell test-feature"><div><span class="eyebrow">Premier dossier</span><h2>Jibble, sous le regard du protocole Datagraphe.</h2><p>Le suivi du temps, les feuilles de temps, les rapports et les fonctions avancées font l’objet d’un examen structuré. Le dossier éditorial est en cours de finalisation.</p><div class="actions"><a class="button primary" href="/tests/jibble/">Découvrir le dossier</a></div></div><div class="test-panel"><StatusBadge status="partial" label="Test en cours de finalisation"/><h3>Jibble</h3><p>Gestion du temps · Dossier Datagraphe en préparation</p></div></div></section>
  <section><div class="shell"><div class="section-head"><div><span class="eyebrow">Champ d’analyse</span><h2>Les outils que les petites entreprises peuvent adopter en ligne.</h2></div><p>Nous privilégions les SaaS accessibles aux indépendants, TPE et PME : découverte, essai et souscription en ligne lorsque cela est possible.</p></div><div class="category-grid">{cats.map(([name,icon,href])=><CategoryCard name={name} icon={icon} href={href}/>)}</div></div></section>
  <section class="dark"><div class="shell promise-grid"><div class="section-head"><div><span class="eyebrow">Promesse éditoriale</span><h2>Voir une fonction n’est pas la tester.</h2><p>Chaque conclusion doit pouvoir être rattachée à une action et à un résultat observé. Quand le test s’arrête, nous le disons.</p></div></div><div class="status-list"><div class="status-row"><span>Action exécutée et résultat observé</span><StatusBadge status="tested"/></div><div class="status-row"><span>Scénario incomplet ou preuve limitée</span><StatusBadge status="partial"/></div><div class="status-row"><span>Contexte matériel ou externe requis</span><StatusBadge status="not-testable"/></div><div class="status-row"><span>Affirmation encore sans preuve</span><StatusBadge status="unverified"/></div></div></div></section>
  <section class="social-section"><div class="shell social-section-inner"><div><span class="eyebrow">Suivez Datagraphe</span><h2>Retrouvez-nous sur les réseaux.</h2><p>Retrouvez nos tests, comparatifs et analyses de logiciels en vidéo.</p></div><SocialLinks class="social-links-home" /></div></section>
</BaseLayout>
