import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumb from '@/components/Breadcrumb.astro'; import StatusBadge from '@/components/StatusBadge.astro';
---
<BaseLayout title="Notre méthodologie de test — Datagraphe" description="Découvrez comment Datagraphe teste, documente et compare les logiciels avec des statuts transparents et des preuves observables."><header class="page-hero"><div class="shell"><Breadcrumb items={[{label:'Accueil',href:'/'},{label:'Méthodologie'}]}/><span class="eyebrow">Protocole éditorial</span><h1>Tester, c’est agir puis observer.</h1><p>Notre méthode cherche moins à tout affirmer qu’à qualifier précisément ce qui a été vérifié — et ce qui ne l’a pas été.</p></div></header><section><article class="content"><h2>Le protocole général</h2><ol><li>Inventorier les fonctionnalités annoncées.</li><li>Créer un environnement de test entièrement fictif.</li><li>Exécuter des scénarios d’utilisation concrets.</li><li>Observer les résultats et collecter les limites.</li><li>Vérifier chaque affirmation à l’aide des preuves disponibles.</li><li>Attribuer un score uniquement lorsque suffisamment de données existent.</li><li>Préparer les comparatifs concurrents avec un cadre équivalent.</li></ol><blockquote>Voir une fonction ≠ tester une fonction. Une fonction doit avoir réellement été manipulée avant d’être qualifiée de testée.</blockquote><h2>Nos statuts</h2><div class="status-list"><div class="status-row"><span>Action exécutée, résultat observé et preuve conservée</span><StatusBadge status="tested" label="TESTED"/></div><div class="status-row"><span>Scénario incomplet ou validation limitée</span><StatusBadge status="partial" label="PARTIAL"/></div><div class="status-row"><span>Le contexte de test ne permet pas l’exécution</span><StatusBadge status="not-testable" label="NOT_TESTABLE"/></div><div class="status-row"><span>Une contrainte a interrompu le scénario</span><StatusBadge status="blocked" label="BLOCKED"/></div><div class="status-row"><span>Fonction absente du plan ou de l’environnement</span><StatusBadge status="not-available" label="NOT_AVAILABLE"/></div></div><h2>Nos tests ont des limites</h2><p>Un environnement web ne permet pas nécessairement de tester un GPS réel, un mode hors ligne, un kiosque physique, des appareils mobiles ou certaines intégrations externes. Nous publions ces limites : elles font partie du résultat, au même titre qu’une fonction réussie.</p></article></section></BaseLayout>
