---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumb from '@/components/Breadcrumb.astro'; import StatusBadge from '@/components/StatusBadge.astro'; import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro'; import FAQ from '@/components/FAQ.astro';
const features=['Pointage','Feuilles de temps','Heures supplémentaires','Projets','Rapports','Exports','GPS / terrain','Kiosque'];
const faq=[{q:'Le test Jibble est-il terminé ?',a:'Le protocole a produit des observations, mais le dossier éditorial public est encore en cours de consolidation.'},{q:'Pourquoi aucun score n’est-il affiché ?',a:'Datagraphe ne publie un score que lorsque les données disponibles sont suffisamment complètes et comparables.'},{q:'Jibble sera-t-il comparé à d’autres outils ?',a:'Les cadres Jibble vs Clockify, Toggl Track et Deputy sont prévus. Aucun résultat comparatif n’est publié avant des tests équivalents.'}];
const softwareSchema={'@context':'https://schema.org','@type':'SoftwareApplication',name:'Jibble',url:'https://www.jibble.io/fr',applicationCategory:'BusinessApplication',applicationSubCategory:'Logiciel de gestion du temps',operatingSystem:'Web',description:'Logiciel de gestion du temps soumis au protocole de test Datagraphe.'};
---
<BaseLayout title="Test Jibble pour TPE et PME — Dossier Datagraphe" description="Jibble mérite-t-il votre temps ? Structure du test Datagraphe, fonctions examinées, preuves attendues et limites documentées."><script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)}/><header class="page-hero"><div class="shell"><Breadcrumb items={[{label:'Tests logiciels',href:'/tests/'},{label:'Gestion du temps',href:'/categories/gestion-du-temps/'},{label:'Jibble'}]}/><div><span class="status status-partial">Test Datagraphe</span> <span class="status">Gestion du temps</span></div><h1>Test Jibble</h1><p>Jibble mérite-t-il votre temps ?</p></div></header><section><div class="shell test-layout"><article class="content" style="width:auto"><div id="verdict" class="verdict-box"><span class="eyebrow">Verdict en 30 secondes</span><h2>Dossier en cours de finalisation.</h2><p>Les observations du protocole sont en cours de consolidation. Aucun verdict définitif, tarif, score ou résultat comparatif n’est publié à ce stade.</p><StatusBadge status="partial" label="Publication partielle"/></div><h2 id="protocole">Notre protocole</h2><p>Le test repose sur un environnement fictif, des scénarios d’utilisation, l’observation des résultats et la conservation de preuves. Une fonction n’est qualifiée de testée qu’après manipulation réelle.</p><p><a href="/methodologie/">Consulter la méthodologie complète de Datagraphe</a>.</p><div class="two-col"><div><h3 id="teste">Ce que nous avons testé</h3><div class="placeholder">La liste vérifiée sera importée depuis le dossier de test réel.</div></div><div><h3 id="non-teste">Ce que nous n’avons pas pu tester</h3><div class="placeholder">Les limites matérielles et contextuelles seront publiées avec leur statut.</div></div></div><h2 id="profil">Pour qui ?</h2><div class="placeholder">Recommandations en attente de validation éditoriale.</div><h2>À éviter si</h2><div class="placeholder">Limites décisives en attente de validation éditoriale.</div><h2 id="fonctions">Fonctionnalités examinées</h2><div class="feature-grid">{features.map(name=><article class="feature-card"><h3>{name}</h3><StatusBadge status="unverified"/><p>Résultats non encore importés dans cette publication.</p></article>)}</div><h2 id="avantages">Avantages et inconvénients</h2><div class="two-col"><div class="placeholder"><strong>Avantages</strong><p>À compléter après vérification des observations.</p></div><div class="placeholder"><strong>Inconvénients</strong><p>À compléter après vérification des limites.</p></div></div><h2 id="sources">Sources officielles utiles</h2><ul><li><a href="https://www.jibble.io/fr/aide/utiliser-api-de-jibble-pour-vos-besoins-specifiques">Documentation officielle de l’API Jibble</a></li><li><a href="https://www.jibble.io/fr/aide/comment-ma-facture-est-elle-calculee">Informations officielles sur la facturation Jibble</a></li></ul><p>Ces liens servent à vérifier le contexte produit. La présence d’une fonction dans la documentation ne signifie pas qu’elle a été testée par Datagraphe.</p><h2 id="alternatives">Alternatives et comparatifs</h2><p>Clockify, Toggl Track et Deputy font partie du cadre comparatif prévu. Les pages correspondantes ne seront publiées que lorsqu’un contenu utile et vérifié sera disponible.</p><h2 id="faq">FAQ</h2><FAQ items={faq}/><h2 id="final">Verdict final</h2><div class="placeholder">Non publié tant que les preuves et limites ne sont pas consolidées.</div><div class="related-links"><h2>À lire aussi</h2><ul><li><a href="/categories/gestion-du-temps/">Logiciels de gestion du temps pour PME</a></li><li><a href="/tests/">Tous les tests de logiciels</a></li><li><a href="/methodologie/">Méthodologie de test Datagraphe</a></li><li><a href="/transparence/">Transparence et indépendance éditoriale</a></li></ul></div><div style="margin-top:32px"><AffiliateDisclosure/></div></article><aside class="toc"><strong>Dans ce dossier</strong><a href="#verdict">Verdict</a><a href="#protocole">Protocole</a><a href="#teste">Testé</a><a href="#non-teste">Non testé</a><a href="#fonctions">Fonctionnalités</a><a href="#avantages">Avantages & limites</a><a href="#sources">Sources</a><a href="#alternatives">Alternatives</a><a href="#faq">FAQ</a><a href="#final">Verdict final</a></aside></div></section></BaseLayout>
