---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumb from '@/components/Breadcrumb.astro'; import StatusBadge from '@/components/StatusBadge.astro'; import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro'; import FAQ from '@/components/FAQ.astro';
const features=['Pointage','Feuilles de temps','Heures supplémentaires','Projets','Rapports','Exports','GPS / terrain','Kiosque'];
const faq=[{q:'Le test Jibble est-il terminé ?',a:'Le protocole a produit des observations, mais le dossier éditorial public est encore en cours de consolidation.'},{q:'Pourquoi aucun score n’est-il affiché ?',a:'Datagraphe ne publie un score que lorsque les données disponibles sont suffisamment complètes et comparables.'},{q:'Jibble sera-t-il comparé à d’autres outils ?',a:'Les cadres Jibble vs Clockify, Toggl Track et Deputy sont prévus. Aucun résultat comparatif n’est publié avant des tests équivalents.'}];
const softwareSchema={'@context':'https://schema.org','@type':'SoftwareApplication',name:'Jibble',applicationCategory:'BusinessApplication',description:'Logiciel de gestion du temps soumis au protocole de test Datagraphe.'};
---
<BaseLayout title="Test Jibble — Dossier Datagraphe" description="Jibble mérite-t-il votre temps ? Découvrez la structure du test Datagraphe, les fonctions examinées et les limites documentées."><script type="application/ld+json" set:html={JSON.stringify(softwareSchema)}/><header class="page-hero"><div class="shell"><Breadcrumb items={[{label:'Tests logiciels',href:'/tests/'},{label:'Gestion du temps'},{label:'Jibble'}]}/><div><span class="status status-partial">Test Datagraphe</span> <span class="status">Gestion du temps</span></div><h1>Jibble</h1><p>Jibble mérite-t-il votre temps ?</p></div></header><section><div class="shell test-layout"><article class="content" style="width:auto"><div id="verdict" class="verdict-box"><span class="eyebrow">Verdict en 30 secondes</span><h2>Dossier en cours de finalisation.</h2><p>Les observations du protocole sont en cours de consolidation. Aucun verdict définitif, tarif, score ou résultat comparatif n’est publié à ce stade.</p><StatusBadge status="partial" label="Publication partielle"/></div><h2 id="protocole">Notre protocole</h2><p>Le test repose sur un environnement fictif, des scénarios d’utilisation, l’observation des résultats et la conservation de preuves. Une fonction n’est qualifiée de testée qu’après manipulation réelle.</p><div class="two-col"><div><h3 id="teste">Ce que nous avons testé</h3><div class="placeholder">La liste vérifiée sera importée depuis le dossier de test réel.</div></div><div><h3 id="non-teste">Ce que nous n’avons pas pu tester</h3><div class="placeholder">Les limites matérielles et contextuelles seront publiées avec leur statut.</div></div></div><h2 id="profil">Pour qui ?</h2><div class="placeholder">Recommandations en attente de validation éditoriale.</div><h2>À éviter si</h2><div class="placeholder">Limites décisives en attente de validation éditoriale.</div><h2 id="fonctions">Fonctionnalités</h2><div class="feature-grid">{features.map(name=><article class="feature-card"><h3>{name}</h3><StatusBadge status="unverified"/><p>Résultats non encore importés dans cette publication.</p></article>)}</div><h2 id="avantages">Avantages et inconvénients</h2><div class="two-col"><div class="placeholder"><strong>Avantages</strong><p>À compléter après vérification des observations.</p></div><div class="placeholder"><strong>Inconvénients</strong><p>À compléter après vérification des limites.</p></div></div><h2 id="tarifs">Tarifs</h2><p>Le plan gratuit et les fonctions payantes seront présentés après vérification des informations et de leur date de validité.</p><h2 id="alternatives">Alternatives</h2><div class="feature-grid">{['Jibble vs Clockify','Jibble vs Toggl Track','Jibble vs Deputy'].map(name=><article class="feature-card"><h3>{name}</h3><p>Comparatif en préparation. Aucun gagnant désigné.</p></article>)}</div><h2 id="faq">FAQ</h2><FAQ items={faq}/><h2 id="final">Verdict final</h2><div class="placeholder">Non publié tant que les preuves et limites ne sont pas consolidées.</div><div style="margin-top:32px"><AffiliateDisclosure/></div></article><aside class="toc"><strong>Dans ce dossier</strong><a href="#verdict">Verdict</a><a href="#protocole">Protocole</a><a href="#teste">Testé</a><a href="#non-teste">Non testé</a><a href="#fonctions">Fonctionnalités</a><a href="#avantages">Avantages & limites</a><a href="#tarifs">Tarifs</a><a href="#alternatives">Alternatives</a><a href="#faq">FAQ</a><a href="#final">Verdict final</a></aside></div></section></BaseLayout>
